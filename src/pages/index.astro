---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const explainers = [
  {
    slug: "streaming-payouts",
    title: "How streaming payouts work",
    detail: "Why a stream does not translate into one fixed payment to an artist."
  },
  {
    slug: "catalog-ownership",
    title: "What catalog ownership means",
    detail: "How masters, publishing, and catalog transfers affect who is paid."
  },
  {
    slug: "sync-licensing",
    title: "Why sync licensing matters",
    detail: "How audiovisual licensing differs from a standard streaming play."
  },
  {
    slug: "methodology",
    title: "How research is reviewed",
    detail: "The evidence and publication standards behind future case studies."
  }
];
---

<BaseLayout
  title="How Much Music | Music Rights and Catalog Research"
  description="Source-led explainers about music rights, catalog ownership, streaming, and long-term music value."
>
  <section class="hero home-hero">
    <div class="hero-copy">
      <p class="eyebrow">How Much Music</p>
      <h1>Understand how music rights create value.</h1>
      <p>
        How Much Music publishes source-led explainers about streaming, catalog ownership, and
        licensing. Catalog profiles are available to browse while individual case studies are
        researched to a higher editorial standard.
      </p>
      <ul class="hero-proof-list" aria-label="Site approach">
        <li><strong>Sources</strong><span>explained on every editorial page</span></li>
        <li><strong>Limits</strong><span>private royalties are not presented as public facts</span></li>
        <li><strong>Corrections</strong><span>open to public source updates</span></li>
      </ul>
    </div>

    <div class="hero-panel home-search-panel" aria-label="Primary homepage actions">
      <p class="eyebrow">Start Here</p>
      <h2>Read the evidence, then browse the catalog.</h2>
      <div class="home-primary-actions">
        <article class="home-primary-action">
          <p class="eyebrow">1. Explain</p>
          <h3>How music money moves</h3>
          <a class="home-action-link" href={`${baseUrl}insights/`}>Read explainers</a>
        </article>
        <article class="home-primary-action">
          <p class="eyebrow">2. Method</p>
          <h3>How we publish research</h3>
          <a class="home-action-link" href={`${baseUrl}editorial-policy/`}>Read standards</a>
        </article>
        <article class="home-primary-action">
          <p class="eyebrow">3. Browse</p>
          <h3>Find an artist or song</h3>
          <a class="home-action-link" href={`${baseUrl}search/`}>Search catalog</a>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="editorial-guides-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Editorial Guides</p>
        <h2 id="editorial-guides-title">Start with a source-led explainer</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}insights/`}>Open all explainers</a>
    </div>
    <p class="results-note">
      These pages explain the relevant rights, evidence, and uncertainty before applying those ideas to a catalog profile.
    </p>
    <div class="card-grid reviewed-song-grid">
      {explainers.map((explainer) => (
        <article class="card artist-card reviewed-song-card">
          <div class="artist-card-body">
            <p class="eyebrow">Explainer</p>
            <h3><a href={`${baseUrl}insights/${explainer.slug}/`}>{explainer.title}</a></h3>
            <p>{explainer.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="catalog-use-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Catalog Research</p>
      <h2 id="catalog-use-title">Browse profiles without mistaking them for published reporting</h2>
      <p>
        Artist and song profiles are useful navigation records. They are kept out of search indexing
        and advertising while their claims, sources, and model inputs are independently documented.
      </p>
    </div>
    <div class="related-link-row">
      <a href={`${baseUrl}artists/`}>Browse artists</a>
      <a href={`${baseUrl}songs/`}>Browse songs</a>
      <a href={`${baseUrl}search/`}>Search catalog</a>
      <a href={`${baseUrl}contact/`}>Suggest a source or correction</a>
    </div>
  </section>
</BaseLayout>

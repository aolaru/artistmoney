---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { publisher } from "../lib/publication";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="About | How Much Music"
  description="About How Much Music, a source-led editorial site explaining music rights, ownership, and catalog research."
>
  <Breadcrumbs items={[{ label: "Home", href: baseUrl }, { label: "About" }]} />

  <section>
    <p class="eyebrow">About</p>
    <h1>About How Much Music</h1>
    <p class="page-updated">Updated July 29, 2026</p>
    <p>
      How Much Music is a source-led editorial research site about music rights, catalog ownership,
      and why recordings can retain value after release. It does not publish private royalty
      statements, confidential contracts, or unsupported income claims.
    </p>
    <p>
      The main audience is readers who want a plain-language view of music economics: fans,
      creators, catalog buyers, writers, and people trying to understand how streaming, publishing,
      master ownership, and licensing interact.
    </p>
  </section>

  <section class="quick-answer-card" aria-labelledby="about-quick-answer-title">
    <p class="eyebrow">In Short</p>
    <h2 id="about-quick-answer-title">Catalog profiles are not published case studies until the evidence is visible.</h2>
    <p>
      Artist and song profiles can be useful for navigation, but they are noindex until a named
      editorial review documents sources, model inputs, limitations, and a review date.
    </p>
  </section>

  <section>
    <h2>What the Site Publishes</h2>
    <ul class="meta-list">
      <li>Source-led explainers about streaming payouts, catalog ownership, label share, publishing, and sync licensing.</li>
      <li>Catalog research profiles that remain outside search indexing until they meet the publication standard.</li>
      <li>Future case studies only where the public inputs and limitations of a model can be shown.</li>
      <li>Image credits and source notes for artwork and self-hosted artist photos.</li>
    </ul>
  </section>

  <section>
    <h2>Who Publishes and Reviews Pages</h2>
    <div class="editorial-basis-grid">
      <div class="editorial-basis-item">
        <strong>Publisher</strong>
        <span>{publisher.name} publishes and maintains the site. Contact: <a href={`mailto:${publisher.contactEmail}`}>{publisher.contactEmail}</a>.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Review approach</strong>
        <span>Published case studies require substantive sources, documented model inputs, specific limitations, and a review date.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Corrections</strong>
        <span>Readers can send source updates, rights concerns, or image attribution issues through the contact page.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Advertising</strong>
        <span>Advertising status does not decide which artists, songs, or estimates are included.</span>
      </div>
    </div>
  </section>

  <section>
    <h2>Editorial Standard</h2>
    <p>
      A public source can establish a release, credit, certification, chart record, or rights
      context without establishing royalty income. When the evidence cannot support a claim, the
      profile remains in the research catalog rather than being promoted as a completed article.
    </p>
    <p>
      For corrections, source suggestions, or rights concerns, use the contact page.
    </p>
    <div class="related-link-row">
      <a href={`${baseUrl}editorial-policy/`}>Read the editorial policy</a>
      <a href={`${baseUrl}contact/`}>Send a correction</a>
      <a href={`${baseUrl}credits/`}>Review image credits</a>
    </div>
  </section>
</BaseLayout>

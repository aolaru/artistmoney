---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { publisher } from "../lib/publication";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Editorial Policy | How Much Music"
  description="How Much Music's editorial policy for estimates, sources, corrections, and page quality."
>
  <Breadcrumbs items={[{ label: "Home", href: baseUrl }, { label: "Editorial Policy" }]} />

  <section>
    <p class="eyebrow">Editorial Policy</p>
    <h1>How Estimates and Pages Are Reviewed</h1>
    <p class="page-updated">Updated July 29, 2026</p>
    <p>
      How Much Music publishes source-led explainers and, when evidence permits, documented catalog
      case studies. We do not treat private royalty statements, confidential contracts, distributor
      dashboards, or unverified model fields as public evidence.
    </p>
  </section>

  <section class="quick-answer-card" aria-labelledby="policy-quick-answer-title">
    <p class="eyebrow">Quick Answer</p>
    <h2 id="policy-quick-answer-title">A case study must show what supports it, what the model uses, and what remains unknown.</h2>
    <p>
      Catalog profiles are kept out of search indexing until they meet this standard. They are not
      called reviewed pages merely because they have platform links or structured metadata.
    </p>
  </section>

  <nav class="page-jump-list" aria-label="Editorial policy sections">
    <a href="#policy-publish">What we publish</a>
    <a href="#policy-estimates">Estimate rules</a>
    <a href="#policy-sources">Sources</a>
    <a href="#policy-indexing">Publication gate</a>
    <a href="#policy-corrections">Corrections</a>
  </nav>

  <section id="policy-publish">
    <h2>What We Publish and Why</h2>
    <div class="editorial-basis-grid">
      <div class="editorial-basis-item">
        <strong>Purpose</strong>
        <span>
          Explain music catalog economics in plain language, with public sources that readers can
          inspect and clear limits around private financial information.
        </span>
      </div>
      <div class="editorial-basis-item">
        <strong>Publisher</strong>
        <span>
          Pages are published by {publisher.name}. Reader corrections, source updates, and
          attribution issues should be sent to <a href={`mailto:${publisher.contactEmail}`}>{publisher.contactEmail}</a>.
        </span>
      </div>
      <div class="editorial-basis-item">
        <strong>Evidence Standard</strong>
        <span>
          A case study needs at least three substantive public sources across at least two evidence
          roles: primary record, independent reporting, or rights context.
        </span>
      </div>
      <div class="editorial-basis-item">
        <strong>Limits</strong>
        <span>
          Model inputs, assumptions, limitations, author, and review date must be visible before a
          financial range can be published as editorial research.
        </span>
      </div>
    </div>
  </section>

  <section id="policy-estimates">
    <h2>Estimate Rules</h2>
    <ul class="meta-list">
      <li>A range is published only when its public inputs and source roles can be described on the page.</li>
      <li>Artist-side and gross activity are separated only when the available evidence supports that distinction.</li>
      <li>Private contracts, royalties, and recoupment cannot be inferred from a stream count, chart position, or artist homepage.</li>
      <li>Profiles that fail the standard remain browseable, noindex, and excluded from advertising and the sitemap.</li>
    </ul>
  </section>

  <section id="policy-sources">
    <h2>Source Handling</h2>
    <p>
      Editorial review distinguishes source roles. Primary records, independent reporting, and rights
      context can support different parts of an analysis. Artist homepages and platform links can
      establish identity or availability, but cannot qualify a financial claim on their own.
    </p>
  </section>

  <section id="policy-indexing">
    <h2>Publication and Reader Gate</h2>
    <p>
      Not every artist or song entry is treated as a finished article. A page is promoted only after
      it has page-specific evidence, a documented model record, named editorial responsibility, and
      a visible corrections path. Utility directories, incomplete profiles, update logs, album pages,
      and broad browsing pages remain available for navigation but are excluded from search indexing.
    </p>
  </section>

  <section>
    <h2>What We Do Not Treat as Proof</h2>
    <ul class="meta-list">
      <li>A high stream count does not prove one universal per-stream payout rate.</li>
      <li>A catalog sale mention does not prove the artist personally receives the whole sale value.</li>
      <li>An official music or platform page confirms identity and availability, not complete royalty income.</li>
      <li>Modeled estimates are not substitutes for royalty statements, contracts, audits, or distributor dashboards.</li>
    </ul>
  </section>

  <section id="policy-corrections">
    <h2>Corrections</h2>
    <p>
      Corrections are reviewed when a public source shows that a page has outdated ownership
      context, incorrect release information, broken image attribution, or a materially misleading
      estimate. Send corrections through the contact page.
    </p>
  </section>

  <section>
    <h2>Advertising Separation</h2>
    <p>
      Advertising does not determine which artists, songs, albums, or estimates are included. Pages
      are selected and updated according to editorial relevance, available context, and catalog
      research value.
    </p>
  </section>

  <section class="related-reading-card" aria-labelledby="policy-related-title">
    <h2 id="policy-related-title">Related pages</h2>
    <div class="related-link-row">
      <a href={`${baseUrl}about/`}>About the site</a>
      <a href={`${baseUrl}contact/`}>Send a correction</a>
      <a href={`${baseUrl}insights/methodology/`}>Methodology</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies } from "../data/caseStudies";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const artistCaseStudies = caseStudies.filter((caseStudy) =>
  caseStudy.relatedProfiles?.some((profile) => profile.type === "artist")
);
---

<BaseLayout
  title="Published Artist Research | How Much Music"
  description="Source-backed music case studies with artist-level public records, evidence limits, and related catalog links."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Published Research</p>
      <h1>Source-backed questions about artists and their work.</h1>
      <p>
        These articles distinguish public chart and credit records from the private agreements that
        would be needed to verify a person's income.
      </p>
    </div>
    <div class="hero-panel" aria-label="Published artist research summary">
      <p class="eyebrow">Available Now</p>
      <a class="hero-stat-pill hero-stat-pill-primary" href={`${baseUrl}case-studies/`}>
        <strong>{artistCaseStudies.length}</strong>
        <span>source-backed artist articles</span>
      </a>
      <a class="hero-stat-pill" href={`${baseUrl}artists/`}>
        <strong>Catalog</strong>
        <span>browse all artist records</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="artist-case-studies-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Case Studies</p>
        <h2 id="artist-case-studies-title">Start with a documented question</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}case-studies/`}>Open all case studies</a>
    </div>
    <div class="card-grid case-study-grid">
      {artistCaseStudies.map((caseStudy) => (
        <article class="card case-study-card">
          <div class="artist-card-body">
            <p class="eyebrow">{caseStudy.focus}</p>
            <h3><a href={`${baseUrl}case-studies/${caseStudy.slug}/`}>{caseStudy.title}</a></h3>
            <p class="card-byline">{caseStudy.artist}</p>
            <p>{caseStudy.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

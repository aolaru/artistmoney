---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Artist Research Queue | How Much Music"
  description="How Much Music's research queue for artist profiles awaiting source-backed editorial review."
  noindex
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Research Queue</p>
      <h1>Artist profiles awaiting evidence review.</h1>
      <p>
        The catalog remains available for navigation and comparison. It is not currently presented
        as a collection of finished editorial case studies.
      </p>
      <p>
        Browse the <a href={`${baseUrl}artists/`}>artist catalog</a> or read the
        <a href={`${baseUrl}editorial-policy/`}>publication standard</a>.
      </p>
    </div>
    <div class="hero-panel" aria-label="Publication status">
      <p class="eyebrow">Publication Status</p>
      <div class="hero-stat-pill hero-stat-pill-primary">
        <strong>0</strong>
        <span>published artist case studies</span>
      </div>
      <a class="hero-stat-pill" href={`${baseUrl}artists/`}>
        <strong>Catalog</strong>
        <span>browse artist profiles</span>
      </a>
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="artist-standard-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Publication Standard</p>
      <h2 id="artist-standard-title">What a published artist case study must include</h2>
      <p>
        A page is published only when a reader can see the public evidence, the model inputs, and
        the limits of the conclusion without relying on generic catalog copy.
      </p>
    </div>
    <div class="editorial-basis-grid">
      <div class="editorial-basis-item">
        <strong>Evidence</strong>
        <span>At least three substantive public sources, across at least two evidence roles.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Model record</strong>
        <span>Inputs, assumptions, limitations, author, and review date must be visible on the page.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Publication rule</strong>
        <span>Platform and artist-homepage links help with identity but do not qualify a financial claim.</span>
      </div>
    </div>
  </section>

  <section class="related-reading-card" aria-labelledby="artist-queue-next-title">
    <h2 id="artist-queue-next-title">What readers can use now</h2>
    <div class="related-link-row">
      <a href={`${baseUrl}artists/`}>Browse catalog profiles</a>
      <a href={`${baseUrl}insights/`}>Read source-led explainers</a>
      <a href={`${baseUrl}insights/catalog-ownership/`}>Understand catalog ownership</a>
    </div>
  </section>
</BaseLayout>

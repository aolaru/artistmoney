---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { archivedSiteUpdates, recentSiteUpdates } from "../data/siteUpdates";
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const updateDescription = "A curated record of meaningful How Much Music additions, improvements, and fixes.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "How Much Music Updates",
  description: updateDescription,
  url: new URL(`${baseUrl}updates/`, Astro.site).toString()
};
---

<BaseLayout
  title="Updates | How Much Music"
  description={updateDescription}
  jsonLd={jsonLd}
  noindex
>
  <Breadcrumbs items={[{ label: "Home", href: baseUrl }, { label: "Updates" }]} />

  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Site Updates</p>
      <h1>What changed at How Much Music</h1>
      <p>
        A curated record of meaningful additions, improvements, and fixes. This page does not repeat
        raw repository activity or treat a catalog import as a published article.
      </p>
    </div>
    <div class="hero-panel" aria-label="Update page scope">
      <p class="eyebrow">Update Standard</p>
      <div class="hero-stat-pill hero-stat-pill-primary">
        <strong>{recentSiteUpdates.length}</strong>
        <span>recent site changes</span>
      </div>
      <div class="hero-stat-pill">
        <strong>Curated</strong>
        <span>visitor-facing changes only</span>
      </div>
    </div>
  </section>

  <section class="editorial-basis-card" aria-labelledby="updates-guide-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">How To Read This Page</p>
      <h2 id="updates-guide-title">Changes that matter to readers stay visible.</h2>
      <p>
        Each entry identifies whether something is new, improved, or fixed. Links point to the
        relevant public page when there is one. Routine maintenance and raw catalog-file activity
        are not listed as releases.
      </p>
    </div>
    <div class="editorial-basis-grid">
      <div class="editorial-basis-item">
        <strong>New</strong>
        <span>A public article, reader tool, or accountability feature was added.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Updated</strong>
        <span>An existing page, process, or reader path was materially improved.</span>
      </div>
      <div class="editorial-basis-item">
        <strong>Fixed</strong>
        <span>A publication, discovery, or scope issue was corrected.</span>
      </div>
    </div>
  </section>

  <section aria-labelledby="recent-updates-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Recent Log</p>
        <h2 id="recent-updates-title">Latest updates</h2>
      </div>
      <a class="home-action-link" href={`${baseUrl}case-studies/`}>Browse case studies</a>
    </div>
    <div class="updates-list">
      {recentSiteUpdates.map((update) => (
        <article class="card update-card">
          <div class="artist-card-body">
            <div class="update-header">
              <span class="rank-badge">{update.kind}</span>
              <p class="update-date">{update.date}</p>
            </div>
            <h3>{update.title}</h3>
            <p>{update.detail}</p>
            {update.links && (
              <div class="related-link-row update-related-links" aria-label={`${update.title} links`}>
                {update.links.map((link) => <a href={`${baseUrl}${link.href.slice(1)}`}>{link.label}</a>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <details class="article-section archive-panel updates-archive">
    <summary>Earlier 2026 updates</summary>
    <div class="updates-list">
      {archivedSiteUpdates.map((update) => (
        <article class="card update-card">
          <div class="artist-card-body">
            <div class="update-header">
              <span class="rank-badge">{update.kind}</span>
              <p class="update-date">{update.date}</p>
            </div>
            <h3>{update.title}</h3>
            <p>{update.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </details>
</BaseLayout>

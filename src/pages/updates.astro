---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { archivedSiteUpdates, recentSiteUpdates, updateHighlights } from "../data/siteUpdates";
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const allSiteUpdates = [...recentSiteUpdates, ...archivedSiteUpdates];
const kindCounts = Object.fromEntries(
  ["Release", "New", "Updated", "Fixed"].map((kind) => [
    kind,
    allSiteUpdates.filter((update) => update.kind === kind).length
  ])
) as Record<"Release" | "New" | "Updated" | "Fixed", number>;
const updateDescription = "A curated record of meaningful How Much Music additions, improvements, and fixes.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "How Much Music Updates",
  description: updateDescription,
  url: new URL(`${baseUrl}updates/`, Astro.site).toString()
};
---

<BaseLayout
  title="Updates | How Much Music"
  description={updateDescription}
  jsonLd={jsonLd}
  noindex
>
  <Breadcrumbs items={[{ label: "Home", href: baseUrl }, { label: "Updates" }]} />

  <section class="hero updates-hero">
    <div class="hero-copy">
      <p class="eyebrow">Site Updates</p>
      <h1>Latest updates</h1>
      <p>
        Use this page as the site log. To explore music rights research, start with case studies or
        search the catalog rather than reading the changelog first.
      </p>
      <div class="updates-hero-meta" aria-label="Update log scope">
        <span>Curated recent highlights</span>
        <span>Earlier launch log archived below</span>
      </div>
      <div class="related-link-row">
        <a href={`${baseUrl}case-studies/`}>Browse case studies</a>
        <a href={`${baseUrl}search/`}>Search the catalog</a>
      </div>
    </div>
    <div class="hero-panel" aria-label="Update totals">
      <p class="eyebrow">Update Log</p>
      <div class="hero-stat-pill hero-stat-pill-primary">
        <strong>{allSiteUpdates.length}</strong>
        <span>documented site changes</span>
      </div>
      <div class="hero-stat-pill">
        <strong>Since April</strong>
        <span>2026 public launch</span>
      </div>
    </div>
  </section>

  <section class="updates-highlight-section" aria-labelledby="highlights-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Current Direction</p>
        <h2 id="highlights-title">What has changed most</h2>
      </div>
    </div>
    <div class="editorial-grid">
      {updateHighlights.map((highlight) => (
        <article class="card editorial-card updates-highlight-card">
          <div class="artist-card-body">
            <h3>{highlight.title}</h3>
            <p>{highlight.detail}</p>
            <a class="home-action-link" href={`${baseUrl}${highlight.href.slice(1)}`}>{highlight.label}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="updates-type-section" aria-labelledby="change-types-title">
    <div class="editorial-basis-heading">
      <p class="eyebrow">Change Types</p>
      <h2 id="change-types-title">What this log covers</h2>
      <p>
        Only meaningful public changes are recorded. Routine catalog imports and small copy edits are
        grouped into the nearest relevant entry rather than presented as separate releases.
      </p>
    </div>
    <div class="editorial-basis-grid">
      <div class="editorial-basis-item"><strong>Release · {kindCounts.Release}</strong><span>Major public milestones or new site sections.</span></div>
      <div class="editorial-basis-item"><strong>New · {kindCounts.New}</strong><span>New public articles, pages, or reader features.</span></div>
      <div class="editorial-basis-item"><strong>Updated · {kindCounts.Updated}</strong><span>Meaningful improvements to content, navigation, or standards.</span></div>
      <div class="editorial-basis-item"><strong>Fixed · {kindCounts.Fixed}</strong><span>Corrections to publication scope, discovery, or interface behavior.</span></div>
    </div>
  </section>

  <section class="updates-log-section" aria-labelledby="recent-updates-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Recent Log</p>
        <h2 id="recent-updates-title">Newest changes first</h2>
        <p class="results-note">The most recent direction stays visible here; the launch history remains available below.</p>
      </div>
    </div>
    <div class="changelog-list">
      {recentSiteUpdates.map((update) => (
        <article class="changelog-entry">
          <div class="changelog-stamp">
            <time>{update.date}</time>
            <span class="rank-badge">{update.kind}</span>
          </div>
          <div>
            <h3>{update.title}</h3>
            <p>{update.detail}</p>
            {update.links && (
              <div class="related-link-row changelog-links" aria-label={`${update.title} links`}>
                {update.links.map((link) => <a href={`${baseUrl}${link.href.slice(1)}`}>{link.label}</a>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <details class="article-section archive-panel updates-archive">
    <summary>Earlier launch log</summary>
    <div class="changelog-list changelog-list-archive">
      {archivedSiteUpdates.map((update) => (
        <article class="changelog-entry">
          <div class="changelog-stamp">
            <time>{update.date}</time>
            <span class="rank-badge">{update.kind}</span>
          </div>
          <div>
            <h3>{update.title}</h3>
            <p>{update.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </details>
</BaseLayout>

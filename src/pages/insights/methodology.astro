---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialSources from "../../components/EditorialSources.astro";
import { editorialSources } from "../../data/editorialSources";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Methodology | How Much Music"
  description="How How Much Music models annual earnings ranges, separates gross and artist-side estimates, and reviews pages before indexing."
  type="article"
>
  <Breadcrumbs items={[
    { label: "Home", href: baseUrl },
    { label: "Insights", href: `${baseUrl}insights/` },
    { label: "Methodology" }
  ]} />

  <section>
    <p class="eyebrow">Methodology</p>
    <h1>How earnings are modeled</h1>
    <p class="page-updated">Updated July 29, 2026</p>
    <p>
      The estimates use conservative modeled ranges, not audited royalty statements. The goal is to
      make catalog economics legible without pretending to have access to private contracts.
    </p>
  </section>

  <section class="quick-answer-card" aria-labelledby="methodology-quick-answer-title">
    <p class="eyebrow">Quick Answer</p>
    <h2 id="methodology-quick-answer-title">A number is published only when its public inputs can be explained.</h2>
    <p>
      Catalog profiles can remain available for navigation, but a page becomes an indexable case
      study only after its evidence, model inputs, author, review date, and limitations are visible.
    </p>
  </section>

  <nav class="page-jump-list" aria-label="Methodology sections">
    <a href="#methodology-represents">What estimates represent</a>
    <a href="#methodology-ready">Ready for readers</a>
    <a href="#methodology-sources">Source labels</a>
    <a href="#methodology-rankings">Rankings</a>
    <a href="#methodology-uncertainty">Uncertainty</a>
  </nav>

  <section id="methodology-represents">
    <h2>What the estimates represent</h2>
    <ul class="meta-list">
      <li>A published range must identify the public inputs used to create it and the source attached to each input.</li>
      <li>Gross activity and artist-side participation are kept separate only when the public evidence supports that distinction.</li>
      <li>Ownership context can explain where value may flow, but it cannot substitute for a private contract or royalty statement.</li>
      <li>When public evidence cannot support a range, the page remains a noindex catalog profile instead of a published estimate.</li>
    </ul>
  </section>

  <section id="methodology-ready">
    <h2>What makes a page ready for readers</h2>
    <p>
      A case study must answer a page-specific question with evidence a reader can inspect.
    </p>
    <ul class="meta-list">
      <li>It needs at least three substantive public sources across at least two evidence roles, such as primary records, independent reporting, and rights context.</li>
      <li>It needs a named editorial desk, review date, model inputs, assumptions, and at least two specific limitations.</li>
      <li>Platform and artist-homepage links may support identity, but do not qualify a financial claim.</li>
      <li>Pages with incomplete research remain available for navigation but are noindex and excluded from the sitemap.</li>
    </ul>
  </section>

  <section id="methodology-sources">
    <h2>How source labels should be read</h2>
    <ul class="meta-list">
      <li><strong>Primary record</strong> links point to public agencies, registries, or rightsholder disclosures.</li>
      <li><strong>Independent reporting</strong> links document public commercial context without being treated as a royalty statement.</li>
      <li><strong>Rights context</strong> links explain how a relevant music-rights system works.</li>
      <li><strong>Identity context</strong> links confirm public artist or track identity and cannot qualify an estimate by themselves.</li>
      <li>No source label is read as proof of a private royalty statement unless the source itself discloses royalty data.</li>
    </ul>
  </section>

  <section class="example-card" aria-labelledby="methodology-example-title">
    <p class="eyebrow">Example</p>
    <h2 id="methodology-example-title">Why two popular songs can show different ranges</h2>
    <p>
      Two songs can have similar public demand but different rightsholder structures. A responsible
      case study states what public evidence supports that difference and does not fill the gaps
      with generic language or a precise-looking number.
    </p>
  </section>

  <section id="methodology-rankings">
    <h2>How rankings work</h2>
    <ul class="meta-list">
      <li>Rankings are not published while the underlying case studies are in the research queue.</li>
      <li>A future ranking will include only pages that meet the same evidence and documentation standard.</li>
      <li>Any future comparison remains editorial context, not a substitute for accounting data.</li>
    </ul>
  </section>

  <section id="methodology-uncertainty">
    <h2>What still introduces uncertainty</h2>
    <ul class="meta-list">
      <li>Legacy contract terms are rarely public.</li>
      <li>Catalog-sale details can materially alter the performer or estate share.</li>
      <li>Streaming mix, geography, and licensing activity change over time.</li>
      <li>Platform-reported play counts do not map cleanly to take-home earnings, so an unsupported range is not published.</li>
    </ul>
  </section>

  <EditorialSources sources={editorialSources.methodology} />
</BaseLayout>
